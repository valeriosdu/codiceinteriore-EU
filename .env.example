# Variabili d'ambiente del frontend (tutte VITE_*, pubbliche, finiscono nel
# bundle). Copiare in `.env` per lo sviluppo locale; in produzione si impostano
# nel pannello Vercel, un set per dominio/mercato.
#
# Un progetto Vercel = un dominio = un mercato. Cambiando VITE_MARKET e i
# valori VITE_* qui sotto si ottiene il sito dell'altro mercato dallo stesso
# repo, senza modifiche al codice.

# Supabase (stesso progetto per tutti i mercati)
VITE_SUPABASE_PROJECT_ID="..."
VITE_SUPABASE_PUBLISHABLE_KEY="..."
VITE_SUPABASE_URL="https://<project>.supabase.co"

# Mercato attivo: it | es
VITE_MARKET="it"

# --- index.html (sostituiti a build time) ---
# IT:
#   VITE_LANG=it  VITE_LOCALE=it-IT  VITE_SITE_NAME="Codice Interiore"
#   VITE_SITE_URL=https://www.codiceinteriore.it
#   VITE_CONTACT_EMAIL=info@codiceinteriore.it  VITE_ORG_LANGUAGE=Italian
# ES:
#   VITE_LANG=es  VITE_LOCALE=es-ES  VITE_SITE_NAME="Carta Interior"
#   VITE_SITE_URL=https://www.cartainterior.com
#   VITE_CONTACT_EMAIL=info@cartainterior.com  VITE_ORG_LANGUAGE=Spanish
VITE_LANG="it"
VITE_LOCALE="it-IT"
VITE_SITE_NAME="Codice Interiore"
VITE_SITE_URL="https://www.codiceinteriore.it"
VITE_SITE_DESCRIPTION="..."
VITE_DEFAULT_TITLE="Codice Interiore — Lettura del Tema Natale"
VITE_CONTACT_EMAIL="info@codiceinteriore.it"
VITE_ORG_LANGUAGE="Italian"

# Analytics per-mercato (vuoto = tag disattivato). Ogni dominio ha le sue
# proprietà GA4 / Meta Pixel / Clarity.
VITE_GA4_ID=""
VITE_META_PIXEL_ID=""
VITE_CLARITY_ID=""
